{
  "name": "stellar-dao",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "dao:build": "SOROBAN_SDK_BUILD_SYSTEM_SUPPORTS_SPEC_SHAKING_V2=0 cargo build -p token -p governor -p treasury -p auction --release --target wasm32v1-none",
    "dao:bindings": "node scripts/generate-dao-bindings.mjs",
    "dao:generate-config": "node scripts/generate-deployment-config.mjs",
    "dao:clean": "cargo clean",
    "dao:test:unit": "cargo test -p token -p governor -p treasury -p auction",
    "dao:test:e2e": "cargo test -p dao-e2e",
    "dao:test:all": "pnpm dao:test:unit && pnpm dao:test:e2e",
    "goldsky:generate": "pnpm --dir packages/goldsky generate",
    "goldsky:test": "pnpm --dir packages/goldsky test",
    "dao:deploy:local": "node scripts/deploy-dao.mjs configs/local.json",
    "dao:deploy:testnet": "node scripts/deploy-dao.mjs configs/testnet.json",
    "dao:local:up": "node scripts/dao-local-up.mjs",
    "dao:local:down": "node scripts/dao-local-down.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ],
  "devDependencies": {
    "lefthook": "^2.1.12"
  }
}
