{
  "name": "dao-test-stellar",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "typecheck": "pnpm --dir apps/web typecheck",
    "dao:build": "SOROBAN_SDK_BUILD_SYSTEM_SUPPORTS_SPEC_SHAKING_V2=0 cargo build -p token -p governor -p treasury --release --target wasm32v1-none",
    "dao:build:mercury": "SOROBAN_SDK_BUILD_SYSTEM_SUPPORTS_SPEC_SHAKING_V2=0 cargo build -p token -p governor -p treasury --release --target wasm32v1-none --features mercury",
    "dao:bindings": "node scripts/generate-dao-bindings.mjs",
    "dao:test:e2e": "cargo test -p dao-e2e",
    "dao:deploy:local": "node scripts/deploy-dao.mjs configs/local.json",
    "dao:deploy:testnet": "node scripts/deploy-dao.mjs configs/testnet.json",
    "mercury:list": "node scripts/mercury.mjs list",
    "mercury:tables": "node scripts/mercury.mjs tables",
    "mercury:status": "node scripts/mercury.mjs status",
    "mercury:query": "node scripts/mercury.mjs query",
    "mercury:delete:plan": "node scripts/mercury.mjs delete-plan",
    "mercury:deploy:local": "node scripts/deploy-dao-mercury.mjs configs/local.json",
    "mercury:deploy:testnet": "node scripts/deploy-dao-mercury.mjs configs/testnet.json",
    "dao:local:up": "node scripts/dao-local-up.mjs",
    "dao:local:down": "node scripts/dao-local-down.mjs",
    "dao:setup:local": "node scripts/dao-setup-local.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*"
  ]
}
