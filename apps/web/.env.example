# Set this to `local` or `testnet`.
NEXT_PUBLIC_STELLAR_NETWORK=local

# Local: http://localhost:8000/rpc
# Testnet: https://soroban-testnet.stellar.org
NEXT_PUBLIC_STELLAR_RPC_URL=http://localhost:8000/rpc

# Local: Standalone Network ; February 2017
# Testnet: Test SDF Network ; September 2015
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# Same admin address for both local and testnet.
NEXT_PUBLIC_STELLAR_ADMIN_ADDRESS=GCLGEIQB4RCG63LSIBSHQ6T67YICWKTHSORNHVXHFVVGXISZU3MQU6CO

